# ApexFlow Python SDK Examples Configuration Template

# Control Plane API Base URL
# - For local development: http://127.0.0.1:8000
# - For deployed production: https://<your-backend-service>.onrender.com
APEXFLOW_BASE_URL=http://127.0.0.1:8000

# Project Authentication Key (from ApexFlow Dashboard -> Project Keys)
APEXFLOW_PROJECT_KEY=your_project_key_here

# Optional Zero-Knowledge Client-Side Payload Encryption Key (AES-256-GCM)
APEXFLOW_ENCRYPTION_KEY=your_secret_passphrase_or_64char_hex_key
