# ==============================================================================
# ApexFlow Control Plane - Production Environment Configuration Template
# File: .env.production.example
# ==============================================================================
# Instructions:
# 1. Copy these settings into your cloud provider's environment variables
#    (e.g., Render Dashboard, Railway Environment Variables, or Docker container).
# 2. Replace all placeholder values with your real credentials.
# ==============================================================================

# Core Application Settings
PROJECT_NAME="ApexFlow Control Plane"
VERSION="0.1.0"
ENVIRONMENT="production"
DEBUG=False
DB_ECHO=False
PORT=8000

# ==============================================================================
# Database Configuration (PostgreSQL / Supabase)
# ==============================================================================
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>
# If using Supabase in production:
# - Use the Transaction Pooler (port 6543) or Session Pooler (port 5432).
# - Example: postgresql+asyncpg://postgres.<project_ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql+asyncpg://postgres.<project_ref>:<password>@<db-host>:6543/postgres"

# ==============================================================================
# Supabase Authentication & Dashboard JWT Verification
# ==============================================================================
# Secret key used by the backend to verify JWT tokens from Supabase Auth
SUPABASE_JWT_SECRET="your-supabase-jwt-secret-from-dashboard-api-settings"
SUPABASE_JWKS_URL="https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json"
SUPABASE_SERVICE_KEY="your-supabase-service-role-secret-key"
SUPABASE_PUB_KEY="your-supabase-anon-public-key"
SUPABASE_SECRET_KEY="your-supabase-secret-key"

# ==============================================================================
# CORS Configuration
# ==============================================================================
# Comma-separated list of allowed origins.
# IMPORTANT: Must include your deployed frontend dashboard domain(s).
# Example: https://apexflow.yourdomain.com,https://apexflow-dashboard.vercel.app
BACKEND_CORS_ORIGINS="https://your-production-dashboard.vercel.app,https://yourdomain.com"

# ==============================================================================
# Storage Configuration - S3-Compatible Object Storage (Payload Offloading)
# ==============================================================================
# In production, STORAGE_PROVIDER MUST be "s3" (or "cloudflare").
# Note: "local" disk storage is strictly forbidden in production to prevent
# ephemeral container disks (e.g. Render, Railway) from filling up.
STORAGE_PROVIDER="s3"

# Size thresholds for automatic offloading
PAYLOAD_MAX_INLINE_BYTES=262144   # 250 KB (payloads larger than this are offloaded)
PAYLOAD_MAX_SINGLE_BYTES=2097152  # 2 MB (maximum single payload ceiling for control plane)

# The backend uses the universal AWS S3 protocol (boto3 under the hood).
# It is 100% S3-compatible and works with Cloudflare R2, AWS S3, MinIO, or Supabase Storage:
#
# --- OPTION A: Cloudflare R2 (Recommended - 10 GB Free Tier, $0 Egress Fees) ---
# S3_BUCKET_NAME="apexflow-production"
# S3_ENDPOINT_URL="https://<account_id>.r2.cloudflarestorage.com"
# AWS_ACCESS_KEY_ID="<cloudflare_r2_access_key_id>"
# AWS_SECRET_ACCESS_KEY="<cloudflare_r2_secret_access_key>"
# AWS_REGION="auto"
#
# --- OPTION B: Native AWS S3 ---
# S3_BUCKET_NAME="apexflow-production"
# S3_ENDPOINT_URL=""   # Leave blank for AWS S3
# AWS_ACCESS_KEY_ID="<aws_access_key_id>"
# AWS_SECRET_ACCESS_KEY="<aws_secret_access_key>"
# AWS_REGION="us-east-1"
#
# Active S3 Configuration:
S3_BUCKET_NAME="apexflow-production"
S3_ENDPOINT_URL="https://<cloudflare_account_id>.r2.cloudflarestorage.com"
AWS_ACCESS_KEY_ID="<your_cloudflare_r2_access_key_id>"
AWS_SECRET_ACCESS_KEY="<your_cloudflare_r2_secret_access_key>"
AWS_REGION="auto"
