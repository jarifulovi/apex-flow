PROJECT_NAME="ApexFlow Control Plane"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=True

# Cloud deployment PORT
PORT=8000

# Database connection URL (Asyncpg required for SQLAlchemy async)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/apexflow"

# Supabase JWT secret for verifying Dashboard Auth tokens
SUPABASE_JWT_SECRET="your-supabase-jwt-secret-here"

# CORS Allowed Origins (Comma-separated or JSON list)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
