# ==============================================================================
# ApexFlow Control Plane Backend Environment Configuration Example
# ==============================================================================

# Core Application Settings
PROJECT_NAME="ApexFlow Control Plane"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=True
DB_ECHO=False
PORT=8000

# PostgreSQL Database Connection String (Direct or Supabase Pooler)
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/apexflow"

# Supabase Auth Integration
# Secret key used to decode & verify Dashboard JWT Bearer tokens
SUPABASE_JWT_SECRET="your-supabase-jwt-secret-here"
SUPABASE_JWKS_URL="https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json"

# CORS Allowed Origins (Comma-separated string or JSON list)
# MUST include your deployed frontend URL in production (e.g. https://apexflow-dashboard.vercel.app)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Large Payload Storage Configuration (>250KB offloading)
PAYLOAD_MAX_INLINE_BYTES=262144
STORAGE_PROVIDER="local" # "local" or "s3"
STORAGE_LOCAL_DIR=".apexflow_storage"

# Object Storage Credentials (Required if STORAGE_PROVIDER="s3")
S3_BUCKET_NAME=""
S3_ENDPOINT_URL="" # Cloudflare R2 / MinIO endpoint or blank for AWS S3
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
