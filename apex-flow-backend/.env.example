PROJECT_NAME="ApexFlow Control Plane"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=True

# Cloud deployment PORT (Railway/Render inject $PORT)
PORT=8000

# Supabase Database Connection String (Direct or Connection Pooler)
# e.g., postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/apexflow"

# Supabase Configuration
SUPABASE_JWKS_URL="https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json"
SUPABASE_JWT_SECRET="your-legacy-jwt-secret-here"
SUPABASE_SERVICE_KEY="your-supabase-service-role-key"
SUPABASE_PUB_KEY="your-supabase-publishable-anon-key"
SUPABASE_SECRET_KEY="your-supabase-secret-key"

# CORS Allowed Origins (Comma-separated or JSON list)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
